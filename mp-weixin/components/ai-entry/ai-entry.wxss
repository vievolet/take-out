.ai-entry {
  position: fixed;
  right: 28rpx;
  bottom: 170rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a5c, #e95f3c);
  box-shadow: 0 8rpx 24rpx rgba(233, 95, 60, .4);
}

.ai-icon {
  font-size: 36rpx;
  line-height: 1;
}

.ai-text {
  font-size: 20rpx;
  color: #fff;
  margin-top: 4rpx;
}
