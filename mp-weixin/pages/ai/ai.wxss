.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.banner {
  background: linear-gradient(135deg, #ff8a5c, #e95f3c);
  padding: 48rpx 40rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
}

.banner-sub {
  font-size: 24rpx;
  opacity: .9;
  margin-top: 8rpx;
}

.panel {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.query-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 22rpx;
  color: #e95f3c;
  background: #fef0eb;
  border: 1rpx solid #ffd4c4;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.go-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #ff8a5c, #e95f3c);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.result {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.badge {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.badge-ai {
  color: #1abc9c;
  background: #e8f8f5;
}

.badge-fallback {
  color: #f39c12;
  background: #fef9e7;
}

.total {
  font-size: 24rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #e95f3c;
}

.summary {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  margin: 16rpx 0;
}

.item {
  display: flex;
  align-items: center;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.item-spicy {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.item-reason {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-bottom {
  margin-top: 6rpx;
}

.item-price {
  font-size: 28rpx;
  color: #e95f3c;
  font-weight: 600;
}

.item-qty {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}

.item-btn {
  font-size: 22rpx;
  color: #e95f3c;
  border: 1rpx solid #e95f3c;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.add-all {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #ff8a5c, #e95f3c);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  margin: 24rpx 40rpx;
  line-height: 1.6;
}
